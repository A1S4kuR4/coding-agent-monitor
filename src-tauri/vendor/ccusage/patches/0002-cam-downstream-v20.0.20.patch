+    fn discovers_conversation_dbs_and_skips_sidecars_and_pb_files() {
+        let fixture = fs_fixture!({
+            "conversations/a.db": "",
+            "conversations/b.db": "",
+            "conversations/b.db-wal": "",
+            "conversations/b.db-shm": "",
+            "conversations/legacy.pb": "",
+            "conversations/notes.txt": "",
+        });
