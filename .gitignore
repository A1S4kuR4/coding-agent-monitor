# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.scaffold-root

# Local agent prompts and data-backed design experiments are not product source.
.agents/
src/prototypes/
scripts/generate-prototype*.mjs

# Rust / Tauri build output
src-tauri/target/

# Generated sidecars. Recreate them with `pnpm fetch:sidecar`.
src-tauri/binaries/*.exe

# Local usage exports and runtime data (may contain private usage/cost details)
token-usage*.json
usage-cache.sqlite3*

# Test and visual-review output
test-results/
playwright-report/
screenshots/
src-tauri/icons/android/
src-tauri/icons/ios/

# Local environment and signing material
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vendored ccusage upstream working copies (import/audit only; the committed
# vendored tree lives in src-tauri/vendor/ccusage). Recreate with
# scripts/vendor-ccusage-import.mjs.
.tmp-upstream/

# Vendored workspace build output (separate cargo workspace from src-tauri).
src-tauri/vendor/ccusage/rust/target/
